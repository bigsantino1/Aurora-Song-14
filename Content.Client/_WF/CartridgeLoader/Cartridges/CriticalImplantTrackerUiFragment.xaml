<BoxContainer xmlns="https://spacestation14.io"
              xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
              Orientation="Vertical"
              HorizontalExpand="True"
              VerticalExpand="True"
              Margin="1 0 2 0">
    <PanelContainer StyleClasses="BackgroundDark"></PanelContainer>
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
        <controls:StripeBack>
            <PanelContainer>
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                    <!-- Aurora's Song Start - Mute crit tracker sound -->
                    <controls:SwitchButton
                        Name="ToggleMuteButton"
                        HorizontalAlignment="Right"
                        Margin="5 0 0 0"
                        Pressed="True"
                        OffStateText="{Loc mute-switch-off-state-label}"
                        OnStateText="{Loc mute-switch-on-state-label}" />
                    <!-- Aurora's Song End -->
                    <Label Text="Critical Patients with Implants" Align="Center" HorizontalExpand="True" StyleClasses="LabelBig"/>
                    <Button Name="RefreshButton" Text="Refresh" MinWidth="80"/>
                </BoxContainer>
            </PanelContainer>
        </controls:StripeBack>
        <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer
                Name="PatientList"
                Orientation="Vertical"
                HorizontalExpand="True"
                Margin="8,8,8,8"/>
        </ScrollContainer>
    </BoxContainer>
</BoxContainer>
